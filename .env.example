# ==============================================================================
# Monchis Café — Variables de Entorno de Ejemplo (.env.example)
# ==============================================================================
# IMPORTANTE: Nunca coloques claves reales de producción en este archivo.
# Copia este archivo como '.env' para desarrollo local: cp .env.example .env

# --- Servidores y Puertos ---
PORT=8080
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8080
VITE_APP_URL=http://localhost:3000

# --- Autenticación Stateless (JWT) ---
# Clave secreta para firmar Access Tokens (mínimo 32 caracteres)
JWT_ACCESS_SECRET=monchis_cafe_jwt_super_secret_access_key_32_characters_min
# Clave secreta para firmar Refresh Tokens (mínimo 32 caracteres)
JWT_REFRESH_SECRET=monchis_cafe_jwt_super_secret_refresh_key_32_characters_min
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
ADMIN_DEFAULT_EMAIL=admin@monchiscafe.com

# --- Google reCAPTCHA v2 / v3 ---
RECAPTCHA_SITE_KEY=6LeIx0cYAAAAA_your_google_recaptcha_site_key
RECAPTCHA_SECRET_KEY=6LeIx0cYAAAAA_your_google_recaptcha_secret_key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIx0cYAAAAA_your_google_recaptcha_site_key
VITE_RECAPTCHA_SITE_KEY=6LeIx0cYAAAAA_your_google_recaptcha_site_key

# --- Google Cloud Platform & APIs ---
GOOGLE_CLOUD_PROJECT=monchis-cafe-project-id
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_API_KEY=your_google_api_key_for_maps_and_services
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- Base de Datos Única (PostgreSQL + Prisma) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cafeteria_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cafeteria_db?schema=public

# --- RabbitMQ Mensajería & Patrón Saga ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=cafeteria.events
RABBITMQ_DLX_EXCHANGE=cafeteria.dlx
RABBITMQ_DLQ_NAME=dead_letter_queue
# Reintentos progresivos con retardo en milisegundos (10s, 60s, 300s)
RABBITMQ_RETRY_DELAYS=10000,60000,300000

# --- Redis (Cache, Rate Limiting & Token Blacklist) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# --- Notificaciones por Correo Electrónico (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@monchiscafe.com
SMTP_PASS=your_app_password
SMTP_FROM="Monchis Café <notificaciones@monchiscafe.com>"
ADMIN_ALERT_EMAIL=gerencia@monchiscafe.com
